<rml>
<head>
<title>MitiruEngine Launcher</title>
<link type="text/rcss" href="mitiru:tool_look.rcss"/>
<style>
  /* 値は C++ (mitiru_launcher.dll) が送り、ボタンは action を返すだけ。見た目は tool_look.rcss の部品 */
  body { padding: 16dp 24dp 24dp; box-sizing: border-box; display: flex; flex-direction: column; }

  .head { display: flex; align-items: baseline; margin-bottom: 16dp; }
  .head-title { flex: 1 1 auto; font-size: 28dp; line-height: 36dp; font-weight: 600; }
  .columns { display: flex; flex: 1; }
  .col { display: flex; flex-direction: column; }
  .col.projects { flex: 2; }
  .col.recents { flex: 1; margin-left: 24dp; }
  .scroll { flex: 1; overflow-y: auto; }

  .project { display: flex; align-items: center; min-height: 56dp; padding: 8dp 16dp; }
  .project + .project { border-top: 1dp var(--divider); }
  .project:hover { background-color: var(--subtle-hover); }
  .project-meta { flex: 1; overflow: hidden; }
  .project-name { font-weight: 600; }
  .project-path { color: var(--text-2); font-size: 12dp; line-height: 16dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .project-actions { display: flex; align-items: center; margin-left: 12dp; }
  .project-actions button { margin-left: 4dp; }
  .live { margin-left: 8dp; margin-bottom: 0dp; }

  .add-zone { display: flex; margin-top: 12dp; }
  .add-zone button { margin-right: 8dp; }

  .recent { display: flex; align-items: center; min-height: 40dp; padding: 4dp 16dp; }
  .recent + .recent { border-top: 1dp var(--divider); }
  .recent-name { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .recent-mode { margin-left: 8dp; color: var(--text-3); font-size: 12dp; }
  .recent-time { margin-left: 12dp; color: var(--text-3); font-size: 12dp; }
  .recent .badge { margin: 0dp 0dp 0dp 12dp; }

  toast { left: 24dp; right: 24dp; bottom: 24dp; }
</style>
</head>
<body data-model="view" data-system-theme="">
  <div class="head">
    <div class="head-title">Launcher</div>
    <div class="caption">v0.2.0</div>
  </div>

  <div class="columns">
    <div class="col projects">
      <div class="group-title"><span>Projects</span><span class="caption gap-4">{{ projects.size }}</span></div>
      <div class="scroll">
        <div class="card clip">
          <div class="empty" data-if="projects.size == 0"><span class="ic">&#xE8B7;</span><span>No projects</span></div>
          <div class="project" data-for="p : projects">
            <div class="project-meta">
              <div class="project-name">{{ p.name }}<span class="badge accent live" data-if="p.runningRun || p.runningWatch">Live</span></div>
              <div class="project-path">{{ p.dllPath }}</div>
            </div>
            <div class="project-actions">
              <button class="accent" data-event-click="dispatch('launcher.open', 'index', p.index)"><span class="ic">&#xE768;</span>Open</button>
              <button class="tipped icon" data-event-click="dispatch('launcher.open_folder', 'index', p.index)"><span class="ic only">&#xE8B7;</span><span class="tip short right">Open folder</span></button>
              <button class="tipped icon"
                      data-event-click="confirm('The DLL file stays on disk. Only the launcher entry is removed.', 'Remove from list?', 'launcher.remove_project', 'index', p.index)"><span class="ic only">&#xE74D;</span><span class="tip short right">Remove</span></button>
            </div>
          </div>
        </div>
      </div>
      <div class="add-zone">
        <button class="accent" data-if="env.canScaffold"
                data-event-click="prompt('New project', 'Letters, digits and underscore. Used as the CMake target name and the folder under examples/.', 'launcher.scaffold', 'my_game')"><span class="ic">&#xE710;</span>New project</button>
        <button class="off" data-if="!env.canScaffold"><span class="ic">&#xE710;</span>New project</button>
        <button data-event-click="dispatch('launcher.add_project')"><span class="ic">&#xE8E5;</span>Add DLL</button>
      </div>
    </div>

    <div class="col recents">
      <div class="group-title"><span>Recent runs</span></div>
      <div class="scroll">
        <div class="card clip">
          <div class="empty" data-if="recents.size == 0"><span class="ic">&#xE81C;</span><span>No runs yet</span></div>
          <div class="recent" data-for="r : recents">
            <div class="recent-name">{{ r.projectName }}<span class="recent-mode">{{ r.watching ? 'Watch' : 'Run' }}</span></div>
            <span class="badge ok" data-if="r.exitCode == 0">Exit 0</span>
            <span class="badge bad" data-if="r.exitCode != 0">Exit {{ r.exitCode }}</span>
            <div class="recent-time">{{ r.endedLabel }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <toast data-attr-value="flash" ms="5500"></toast>

  <div class="modal-root" data-if="ui_confirm_open">
    <div class="modal-backdrop" data-event-click="confirm_cancel()"></div>
    <div class="modal">
      <div class="modal-title">{{ ui_confirm_title }}</div>
      <div class="modal-body">{{ ui_confirm_text }}</div>
      <div class="modal-actions">
        <button class="accent" data-event-click="confirm_ok()">OK</button>
        <button data-event-click="confirm_cancel()">Cancel</button>
      </div>
    </div>
  </div>

  <div class="modal-root" data-if="ui_prompt_open">
    <div class="modal-backdrop" data-event-click="prompt_cancel()"></div>
    <div class="modal">
      <div class="modal-title">{{ ui_prompt_title }}</div>
      <div class="modal-body">{{ ui_prompt_text }}</div>
      <input class="text" type="text" autofocus="" data-attr-value="ui_prompt_value" data-event-change="prompt_input()"/>
      <div class="modal-actions">
        <button class="accent" data-event-click="prompt_ok()">OK</button>
        <button data-event-click="prompt_cancel()">Cancel</button>
      </div>
    </div>
  </div>
</body>
</rml>
