<rml>
<head>
<title>Mitiru Dev Companion</title>
<link type="text/rcss" href="mitiru:tool_look.rcss"/>
<style>
  /* watch 中の game の横に出る細長い操作バー。値は C++ (mitiru_dev_companion.dll) が送り、ボタンは action を返すだけ */
  body { display: flex; align-items: center; padding: 0dp 12dp; box-sizing: border-box; border-bottom: 1dp var(--divider); }
  .dotlive { flex: 0 0 auto; width: 10dp; height: 10dp; border-radius: 5dp; background-color: var(--success); }
  .dotlive.dead { background-color: var(--critical); }
  .project { margin-left: 8dp; font-weight: 600; white-space: nowrap; max-width: 240dp; overflow: hidden; text-overflow: ellipsis; }
  .pid { margin-left: 8dp; }
  .status { flex: 1; margin: 0dp 12dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text-2); }
  .status .ok { color: var(--success); }
  .status .bad { color: var(--critical); }
  .status .busy { color: var(--accent); }
  .actions { display: flex; align-items: center; }
  .actions button { margin-left: 4dp; }

  toast { bottom: 4dp; left: 120dp; right: 120dp; padding: 2dp 12dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
</head>
<body data-model="view" data-system-theme="">
  <span class="dotlive" data-class-dead="!env.gameAlive"></span>
  <div class="project">
    <span data-if="env.projectName">{{ env.projectName }}</span><span class="faint" data-if="!env.projectName">No session</span>
    <span class="caption pid" data-if="env.gamePid">PID {{ env.gamePid }}</span>
  </div>
  <div class="status">
    <span class="busy" data-if="build.active">Building...</span>
    <span class="ok" data-if="!build.active &amp;&amp; build.attempted &amp;&amp; build.ok">Built in {{ build.durationMs / 1000 | f2 }} s</span>
    <span class="bad" data-if="!build.active &amp;&amp; build.attempted &amp;&amp; !build.ok">Build failed (exit {{ build.exitCode }})</span>
    <span data-if="!build.active &amp;&amp; !build.attempted">Ready</span>
  </div>
  <div class="actions">
    <button class="accent" data-if="env.buildEnabled &amp;&amp; !build.active"
            data-event-click="dispatch('companion.build')"><span class="ic">&#xE90F;</span>Build</button>
    <button class="off" data-if="build.active"><span class="ic">&#xE895;</span>Building</button>
    <button class="off" data-if="!env.buildEnabled &amp;&amp; !build.active"><span class="ic">&#xE90F;</span>Build</button>
    <button data-if="env.gamePid" data-class-on="env.inspectorOpen"
            data-event-click="dispatch('companion.inspector')"><span class="ic">&#xE890;</span>Inspector</button>
    <button class="off" data-if="!env.gamePid"><span class="ic">&#xE890;</span>Inspector</button>
    <button data-if="env.gameAlive" data-event-click="dispatch('companion.stop')"><span class="ic">&#xE71A;</span>Stop</button>
    <button class="off" data-if="!env.gameAlive"><span class="ic">&#xE71A;</span>Stop</button>
  </div>
  <toast data-attr-value="flash" ms="4000"></toast>
</body>
</rml>
