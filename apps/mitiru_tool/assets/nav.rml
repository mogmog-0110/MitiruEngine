<rml>
<head>
	<title>Navigation</title>
	<link type="text/rcss" href="mitiru:tool_look.rcss"/>
	<style>
		.stats { display: flex; }
		.stat { flex: 1 1 0dp; }
		.stat .figure { font-size: 28dp; line-height: 36dp; }
		.legend .sw.mesh { background-color: var(--divider); border-color: var(--text-3); }
		.legend .sw.closed { background-color: var(--text-2); }
		.legend .sw.agent { background-color: var(--accent); border-width: 0dp; border-radius: 5dp; }
		.legend .sw.stuck { background-color: var(--critical); border-width: 0dp; border-radius: 5dp; }
	</style>
</head>
<body data-model="tool" data-class-is-waiting="!ready">
	<div class="page">
		<div class="card pad">
			<div class="stats">
				<div class="stat"><div class="caption">Agents</div><div class="figure">{{ agents }}</div></div>
				<div class="stat"><div class="caption">Moving</div><div class="figure">{{ moving }}</div></div>
				<div class="stat"><div class="caption">No path</div><div class="figure">{{ stuck }}</div></div>
				<div class="stat"><div class="caption">Closed</div><div class="figure"><span>{{ closed }}</span><span class="unit">/ {{ obstacles }}</span></div></div>
			</div>
		</div>
		<div class="infobar warn" data-if="mesh_file == ''"><span class="ic">&#xE946;</span><span class="msg">No navmesh</span></div>
		<div class="caption mt-8 nowrap" data-if="mesh_file != '' &amp;&amp; mesh_error == ''">{{ mesh_file }} - {{ mesh_tris }} triangles</div>
		<div class="infobar error" data-if="mesh_error != ''"><span class="ic">&#xE783;</span><span class="msg">{{ mesh_error }}</span></div>
		<div class="infobar warn" data-if="nothing"><span class="ic">&#xE946;</span><span class="msg">No agents or obstacles in game memory</span></div>
		<div class="row-flex mt-12"><span class="caption grow">Top view, +x right, +z down</span><span class="caption">Grid <span>{{ grid }}</span></span></div>
		<div class="surface mt-4"><liveimage id="map"/></div>
		<div class="legend"><span class="it"><span class="sw mesh"/><span>Floor</span></span><span class="it"><span class="sw closed"/><span>Closed</span></span><span class="it"><span class="sw"/><span>Open</span></span><span class="it"><span class="sw agent"/><span>Agent</span></span><span class="it"><span class="sw stuck"/><span>No path</span></span></div>
	</div>
	<div class="wait"><span class="ic">&#xE895;</span>Waiting for the game</div>
</body>
</rml>
