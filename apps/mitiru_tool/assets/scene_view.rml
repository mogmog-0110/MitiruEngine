<rml>
<head>
	<title>Scene view</title>
	<link type="text/rcss" href="mitiru:tool_look.rcss"/>
	<style>
		/* ゲーム画面の絵に枠を重ねる。絵の面は暗いまま (ゲームの色を見るため) にする */
		.stage { min-height: 120dp; background-color: #111214; }
		.stage.shown { min-height: 0dp; }
		.overlay { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; pointer-events: none; }
		.box { position: absolute; border: 1dp var(--accent); }
		.box.sel { border: 2dp var(--caution); }
		.box .name { position: absolute; left: 0dp; bottom: 100%; font-size: 12dp; line-height: 14dp; color: var(--accent); white-space: nowrap; }
		.box.sel .name { color: var(--caution); }
		.box .name.inside { bottom: auto; top: 0dp; }
		.marquee { position: absolute; border: 1dp var(--caution); background-color: var(--accent-tint); }
		.port-row { display: flex; align-items: center; }
		.port-row input.text { width: 72dp; margin: 0dp 8dp 0dp 8dp; }
		.port-row .grow { text-align: right; }
		.mini .row { min-height: 32dp; }
		.mini .row.dirty { border-left: 3dp var(--caution); padding-left: 13dp; }
		.mini .k { flex: 0 0 40%; }
		.candidates { display: flex; flex-wrap: wrap; margin-top: 8dp; }
		.candidates button { margin: 0dp 8dp 8dp 0dp; }
		.candidates button .dot { margin-right: 8dp; }
		.gate .row { min-height: 32dp; }
		.gate .reason { margin-left: 8dp; color: var(--text-2); }
	</style>
</head>
<body data-model="tool" data-class-is-waiting="!ready">
	<div class="page">
		<div class="port-row">
			<span class="caption">API port</span>
			<input type="text" class="text small" id="port" data-attr-value="port" data-event-change="dispatch('sv.port', 'v', ev.value)"/>
			<span class="tip-host"><span class="ic mute">&#xE946;</span><span class="tip">Drag a box or pick a candidate to start a branch, then keep or discard it. Shift+drag selects a rectangle, Ctrl+click adds, Esc clears.</span></span>
			<span class="caption grow">{{ status }}</span>
		</div>
		<!-- /api/ai/state の branch を見て、まだ残す / 捨てるを選んでいない field があることを上で常に見せる -->
		<div class="infobar warn" data-if="banner != ''"><span class="ic">&#xE7BA;</span><span class="msg">{{ banner }}</span></div>

		<div class="surface stage mt-8" id="stage" data-class-shown="has_image">
			<liveimage id="shot"/>
			<div class="overlay" data-if="has_image">
				<div class="box" data-for="b : boxes" data-class-sel="b.sel"
				     data-style-left="b.left + '%'" data-style-top="b.top + '%'" data-style-width="b.width + '%'" data-style-height="b.height + '%'">
					<span class="name" data-if="b.has_label" data-class-inside="b.label_inside">{{ b.label }}</span>
				</div>
				<div class="marquee" data-if="marquee.show"
				     data-style-left="marquee.left + '%'" data-style-top="marquee.top + '%'" data-style-width="marquee.width + '%'" data-style-height="marquee.height + '%'"/>
			</div>
		</div>

		<div class="bar mt-8">
			<button class="accent tipped" data-class-off="!can_commit" data-event-click="dispatch('sv.commit')"><span class="ic">&#xE8FB;</span>Keep</button>
			<button data-class-off="!can_commit" data-event-click="dispatch('sv.discard')"><span class="ic">&#xE74D;</span>Discard</button>
			<div class="sep"/>
			<button class="tipped icon" data-class-off="!can_undo" data-event-click="dispatch('sv.undo')"><span class="ic only">&#xE7A7;</span><span class="tip short">Undo</span></button>
			<button class="tipped icon" data-class-off="!can_redo" data-event-click="dispatch('sv.redo')"><span class="ic only">&#xE7A6;</span><span class="tip short">Redo</span></button>
		</div>

		<div class="group" data-if="rows.size &gt; 0 || multi != ''">
			<div class="card mini clip">
				<div class="row" data-if="multi != ''"><span>{{ multi }}</span></div>
				<div class="row" data-for="r : rows" data-class-dirty="r.dirty">
					<div class="k">{{ r.k }}</div>
					<div class="v">{{ r.v }}</div>
					<button class="small" data-if="r.numeric" data-event-click="dispatch('sv.cand', 'k', r.k)">Variants</button>
				</div>
			</div>
		</div>
		<!-- 選んだ数値 field の ±10% / ±25% を 4 案並走 (POST /api/ai/candidates)。ゴーストは host がゲーム画面へ
		     直接重ねるので、この窓は貼った絵にそれが映るだけ。ここは案の一覧と「選ぶ」ボタンを持つ -->
		<div class="candidates">
			<button data-for="c : candidates" data-event-click="dispatch('sv.pick', 'slot', c.slot)"><span class="dot" data-attr-class="'dot s' + c.slot"/>{{ c.label }}</button>
		</div>
		<!-- 「残す」の直後に host が裏で tests/replay_golden/*.mtrr を回した結果 (緑 = 一致、赤 = 壊れた録画) -->
		<div class="group" data-if="gate_runs.size &gt; 0">
			<div class="group-title"><span>{{ gate_title }}</span></div>
			<div class="card gate">
				<div class="row" data-for="g : gate_runs">
					<span class="dot" data-class-ok="g.pass"/>
					<span>{{ g.file }}</span>
					<span class="reason" data-if="g.has_reason">{{ g.reason }}</span>
				</div>
			</div>
		</div>
	</div>
	<div class="wait"><span class="ic">&#xE895;</span>Waiting for the game</div>
</body>
</rml>
