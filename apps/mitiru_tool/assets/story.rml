<rml>
<head>
	<title>Story</title>
	<link type="text/rcss" href="mitiru:tool_look.rcss"/>
	<style>
		.srow { padding: 8dp 16dp; }
		.srow + .srow { border-top: 1dp var(--divider); }
		.srow .name { font-weight: 600; }
		.srow .kind { margin-left: 8dp; color: var(--text-3); font-weight: normal; font-size: 12dp; }
		.srow .line { margin-top: 2dp; }
		.srow .err { margin-top: 2dp; }
		.srow .row { padding-left: 0dp; padding-right: 0dp; min-height: 28dp; }
	</style>
</head>
<body data-model="tool" data-class-is-waiting="!ready">
	<div class="page">
		<div class="card">
			<div class="srow" data-for="r : rows">
				<div class="name">{{ r.label }}<span class="kind">{{ r.kind }}</span></div>
				<div class="line" data-if="r.line != ''">{{ r.line }}</div>
				<div class="err" data-if="r.error != ''">{{ r.error }}</div>
				<div class="row compact" data-for="it : r.items"><span class="k">{{ it.k }}</span><span class="v">{{ it.v }}</span></div>
			</div>
		</div>
	</div>
	<div class="wait"><span class="ic">&#xE895;</span>Waiting for the game</div>
</body>
</rml>
