<rml>
<head>
	<title>Scene tree</title>
	<link type="text/rcss" href="mitiru:tool_look.rcss"/>
	<style>
		/* 木 (exportedInspectables) と game memory (reflect) は別系統のデータ源。tab は表示の切り替えだけで、
		   どちらも読み取り専用のまま (docs/INSPECTOR_DATA_SOURCES.md)。 */
		.tree .row { min-height: 32dp; padding: 0dp 12dp; white-space: nowrap; }
		.tree .row + .row { border-top-width: 0dp; }
		.tree .indent { display: block; flex: 0 0 16dp; width: 16dp; height: 32dp; }
		.tree .tog { display: block; flex: 0 0 20dp; width: 20dp; text-align: center; cursor: pointer; color: var(--text-2); }
		.tree .tog.leaf { cursor: default; }
		.tree .key { font-weight: 600; }
		.tree .colon { color: var(--text-3); margin: 0dp 6dp 0dp 2dp; }
		.tree .hint { margin-left: 8dp; color: var(--text-3); font-size: 12dp; }
	</style>
</head>
<body data-model="tool" data-class-is-waiting="!ready">
	<div class="page">
		<div class="tabs">
			<div class="tab" data-class-cur="tab == 'tree'" data-event-click="dispatch('tab', 'name', 'tree')"><span>Tree</span></div>
			<div class="tab" data-class-cur="tab == 'memory'" data-event-click="dispatch('tab', 'name', 'memory')"><span>Memory</span></div>
		</div>
		<div data-if="tab == 'tree'">
			<div class="card tree clip">
				<div class="row" data-for="r : rows">
					<span class="indent" data-for="i : r.indent"><span/></span>
					<span class="tog leaf" data-if="r.leaf"/>
					<span class="tog" data-if="!r.leaf" data-event-click="dispatch('tree.toggle', 'path', r.path)"><span class="ic" data-if="r.open">&#xE70D;</span><span class="ic" data-if="!r.open">&#xE76C;</span></span>
					<span class="key">{{ r.key }}</span>
					<span class="colon" data-if="r.leaf">:</span>
					<span class="val" data-if="r.leaf">{{ r.val }}</span>
					<span class="hint" data-if="!r.leaf &amp;&amp; r.hint != ''">{{ r.hint }}</span>
				</div>
			</div>
		</div>
		<div data-if="tab == 'memory'">
			<div class="group" data-for="sec : sections">
				<div class="group-title"><span>{{ sec.title }}</span></div>
				<div class="card clip">
					<div data-for="it : sec.items">
						<div class="row" data-if="!it.group">
							<span class="k" data-if="it.has_k">{{ it.k }}</span>
							<span class="v">
								<span data-if="it.w == 'text'">{{ it.v }}</span>
								<span class="combo" data-if="it.w == 'enum'"><span>{{ it.v }}</span><span class="ic">&#xE70D;</span></span>
								<span data-if="it.w == 'range'"><input type="range" class="range" disabled="" data-attr-min="it.min" data-attr-max="it.max" data-attr-value="it.val"/>{{ it.v }}</span>
							</span>
						</div>
						<div class="expander" data-if="it.group">
							<div class="head" data-event-click="dispatch('kv.group', 'name', it.name)">
								<span>{{ it.name }}</span>
								<span class="ic chev" data-if="it.open">&#xE70E;</span><span class="ic chev" data-if="!it.open">&#xE70D;</span>
							</div>
							<div class="body-in" data-if="it.open">
								<div class="row" data-for="r : it.rows">
									<span class="k" data-if="r.has_k">{{ r.k }}</span>
									<span class="v">
										<span data-if="r.w == 'text'">{{ r.v }}</span>
										<span class="combo" data-if="r.w == 'enum'"><span>{{ r.v }}</span><span class="ic">&#xE70D;</span></span>
										<span data-if="r.w == 'range'"><input type="range" class="range" disabled="" data-attr-min="r.min" data-attr-max="r.max" data-attr-value="r.val"/>{{ r.v }}</span>
									</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="wait"><span class="ic">&#xE895;</span>Waiting for the game</div>
</body>
</rml>
