<rml>
<head>
	<title>Side state</title>
	<link type="text/rcss" href="mitiru:tool_look.rcss"/>
	<style>
		.ch { padding: 8dp 16dp; }
		.ch + .ch { border-top: 1dp var(--divider); }
		.ch .top { display: flex; align-items: baseline; }
		.ch .name { flex: 1 1 auto; font-weight: 600; }
		.ch .name .badge { margin: 0dp 0dp 0dp 8dp; }
		.ch .ver { flex: 0 0 40dp; color: var(--text-2); }
		.ch .bytes { flex: 0 0 80dp; text-align: right; }
		.ch .hash { margin-top: 2dp; color: var(--text-3); font-size: 12dp; font-family: var(--font-mono); }
		.strip { padding: 8dp 16dp; }
		.strip + .strip { border-top: 1dp var(--divider); }
		.strip .head { display: flex; align-items: baseline; }
		.strip .head .grow { font-weight: 600; }
		.strip .band { position: relative; height: 16dp; margin-top: 6dp; border-radius: 4dp; background-color: var(--subtle-hover); }
		.strip .mark { position: absolute; top: 2dp; bottom: 2dp; width: 2dp; margin-left: -1dp; background-color: var(--critical); }
	</style>
</head>
<body data-model="tool" data-class-is-waiting="!ready">
	<div class="page">
		<div class="group">
			<div class="group-title"><span>Channels</span></div>
			<div class="card" data-if="!no_channels">
				<div class="ch" data-for="c : channels">
					<div class="top"><span class="name">{{ c.name }}<span class="badge" data-if="c.covers">Per scene</span></span>
						<span class="ver">{{ c.version }}</span><span class="bytes">{{ c.bytes }}</span></div>
					<div class="hash">{{ c.hash }}</div>
				</div>
			</div>
			<div class="card empty" data-if="no_channels"><span class="ic">&#xE946;</span><span>No channels</span></div>
		</div>

		<div class="group">
			<div class="group-title"><span>Record ring</span></div>
			<div class="card">
				<div class="row compact"><span class="k">Frames</span><span class="v">{{ ring_frames }}</span></div>
				<div class="row compact"><span class="k">Used</span><span class="v">{{ ring_used }}</span></div>
				<div class="row compact"><span class="k">Per frame</span><span class="v">{{ ring_per_frame }}</span></div>
				<div class="row compact"><span class="k">Allocated</span><span class="v">{{ ring_alloc }}</span></div>
			</div>
		</div>

		<div class="group" data-if="has_replay">
			<div class="group-title"><span class="grow">Replay check</span><span class="caption"><span>{{ replay_compared }}</span> frames, {{ replay_range }}</span></div>
			<div class="card">
				<div class="strip" data-for="s : strips">
					<div class="head"><span class="grow">{{ s.name }}</span>
						<span class="badge bad" data-if="s.count > 0">{{ s.count }} differ, first {{ s.first }}</span>
						<span class="badge ok" data-if="s.count == 0">Match</span></div>
					<div class="band"><div class="mark" data-for="m : s.marks" data-style-left="m.left"><span/></div></div>
				</div>
			</div>
			<div class="caption mt-8" data-if="replay_dropped">First 256 frames only</div>
		</div>
	</div>
	<div class="wait"><span class="ic">&#xE895;</span>Waiting for the game</div>
</body>
</rml>
