<rml>
<head>
	<title>Animation</title>
	<link type="text/rcss" href="mitiru:tool_look.rcss"/>
	<style>
		.layer, .gl { padding: 8dp 16dp; }
		.layer + .layer, .gl + .gl { border-top: 1dp var(--divider); }
		.layer .top, .gl .top { display: flex; align-items: baseline; }
		.layer .clip { flex: 0 0 34%; font-weight: 600; }
		.layer .time { flex: 0 0 26%; }
		.layer .flags { flex: 1 1 auto; text-align: right; color: var(--text-2); font-size: 12dp; }
		.wrow { display: flex; align-items: center; margin-top: 6dp; }
		.wrow .meter { flex: 1 1 auto; margin-right: 12dp; }
		.wrow .wv { flex: 0 0 44dp; text-align: right; color: var(--text-2); font-size: 12dp; }
		.gl .lname { flex: 0 0 22%; color: var(--text-2); }
		.gl .st { flex: 1 1 auto; font-weight: 600; }
		.gl .ph { flex: 0 0 30%; text-align: right; color: var(--text-2); }
		.gl .sub { margin-top: 2dp; color: var(--text-2); font-size: 12dp; }
		.ev { display: flex; padding: 6dp 16dp; }
		.ev + .ev { border-top: 1dp var(--divider); }
		.ev span { margin-right: 16dp; }
		.fade-arrow { margin: 0dp 8dp; }
	</style>
</head>
<body data-model="tool" data-class-is-waiting="!ready">
	<div class="page">
		<div class="group">
			<div class="group-title"><span>Models</span></div>
			<div class="card list" data-if="!no_poses">
				<div class="item" data-for="p : poses" data-class-sel="p.selected" data-event-click="dispatch('anim.select', 'label', p.label)">
					<span class="name">{{ p.label }}</span><span class="meta">{{ p.n }}</span>
				</div>
			</div>
			<div class="card empty" data-if="no_poses"><span class="ic">&#xE946;</span><span>No models</span></div>
		</div>

		<div data-if="has_graph">
			<div class="group">
				<div class="group-title"><span class="grow">State machine</span><span class="caption">{{ sel_label }} - {{ graph_name }}</span></div>
				<div class="card">
					<div class="gl" data-for="g : graph_layers">
						<div class="top"><span class="lname">{{ g.name }}</span><span class="st">{{ g.state }}</span><span class="ph">{{ g.phase }} - {{ g.time }}</span></div>
						<div class="sub">{{ g.via }}</div>
						<div class="wrow" data-if="g.fading"><span class="caption">{{ g.from }}</span><span class="ic mute fade-arrow">&#xE76C;</span><div class="meter"><div class="fill" data-style-width="g.fade_w"/></div><span class="wv">{{ g.fade }}</span></div>
					</div>
					<div class="empty" data-if="graph_unnamed"><span class="ic">&#xE946;</span><span>No names</span></div>
					<div class="empty" data-if="graph_error != ''"><span>{{ graph_error }}</span></div>
				</div>
			</div>
			<div class="group">
				<div class="group-title"><span>Parameters</span></div>
				<div class="card">
					<div class="row compact" data-for="q : graph_params"><span class="k">{{ q.name }}</span><span class="v">{{ q.value }}</span></div>
				</div>
			</div>
			<div class="group">
				<div class="group-title"><span>Events this step</span></div>
				<div class="card">
					<div class="ev" data-for="e : graph_events"><span>{{ e.name }}</span><span class="muted">{{ e.clip }}</span></div>
					<div class="empty" data-if="no_graph_events"><span>None</span></div>
				</div>
			</div>
		</div>

		<div data-if="has_pose">
			<div class="group">
				<div class="group-title"><span class="grow">Layers</span><span class="caption">{{ sel_label }}</span><span class="badge" data-if="in_place">In place</span></div>
				<div class="card">
					<div class="layer" data-for="l : layers">
						<div class="top"><span class="clip">Clip {{ l.clip }}</span><span class="time">{{ l.time }}</span><span class="flags">{{ l.mask }} - {{ l.flags }}</span></div>
						<div class="wrow"><div class="meter"><div class="fill" data-style-width="l.w"/></div><span class="wv">{{ l.weight }}</span></div>
					</div>
				</div>
			</div>
			<div class="group">
				<div class="group-title"><span>Events this frame</span></div>
				<div class="card">
					<div class="ev" data-for="e : events"><span>Event {{ e.name }}</span><span class="muted">Clip {{ e.clip }}</span><span class="muted">{{ e.time }}</span></div>
					<div class="empty" data-if="no_events"><span>None</span></div>
				</div>
			</div>
		</div>

		<div data-if="has_sel">
			<div class="group">
				<div class="group-title"><span>Root motion</span></div>
				<div class="card" data-if="has_root">
					<div class="row compact"><span class="k">Move</span><span class="v">{{ root_t }}</span></div>
					<div class="row compact"><span class="k">Yaw</span><span class="v">{{ root_yaw }}</span></div>
				</div>
				<div class="card empty" data-if="!has_root"><span>No root motion data</span></div>
			</div>
		</div>
	</div>
	<div class="wait"><span class="ic">&#xE895;</span>Waiting for the game</div>
</body>
</rml>
