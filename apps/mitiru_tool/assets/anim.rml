<rml>
<head>
	<title>anim</title>
	<link type="text/rcss" href="tool.rcss"/>
	<style>
		.list { margin-top: 8dp; background-color: #ffffff; border: 1dp #e6e7ea; }
		.item { display: flex; padding: 4dp 8dp; border-bottom: 1dp #f4f4f2; cursor: pointer;
		        font-family: "IBM Plex Mono"; font-size: 12dp; color: #33363b; }
		.item:hover { background-color: #f4f4f2; }
		.item.sel { background-color: #e6e7ea; color: #1a1c1f; font-weight: bold; }
		.item .name { flex: 1 1 auto; }
		.item .n { color: #999da4; }
		.layer { padding: 5dp 0dp; border-bottom: 1dp #f4f4f2; font-family: "IBM Plex Mono"; font-size: 12dp; }
		.layer .top { display: flex; }
		.layer .clip { flex: 0 0 34%; color: #1a1c1f; font-weight: bold; }
		.layer .time { flex: 0 0 26%; color: #33363b; }
		.layer .flags { flex: 1 1 auto; color: #999da4; text-align: right; }
		.layer .wrow { display: flex; align-items: center; margin-top: 3dp; }
		.layer .bar { position: relative; flex: 1 1 auto; height: 8dp; background-color: #f4f4f2; border: 1dp #e6e7ea; margin-right: 8dp; }
		.layer .bar .fill { position: absolute; left: 0dp; top: 0dp; bottom: 0dp; background-color: #1a1c1f; }
		.layer .wv { flex: 0 0 40dp; text-align: right; color: #1a1c1f; }
		.ev { display: flex; font-family: "IBM Plex Mono"; font-size: 12dp; padding: 2dp 0dp; }
		.ev span { margin-right: 14dp; }
		.kv2 { display: flex; font-family: "IBM Plex Mono"; font-size: 12dp; padding: 2dp 0dp; }
		.kv2 .k { flex: 0 0 34%; color: #6e7077; }
		.kv2 .v { flex: 1 1 auto; color: #1a1c1f; }
	</style>
</head>
<body data-model="tool" data-class-is-waiting="!ready">
	<header><div class="dot"/><h1>anim</h1></header>
	<div class="body">
		<div class="label"><span class="dash">— </span>モデル (AnimPoseParams を持つ値)</div>
		<div class="list" data-if="!no_poses">
			<div class="item" data-for="p : poses" data-class-sel="p.selected" data-event-click="dispatch('anim.select', 'label', p.label)">
				<span class="name">{{ p.label }}</span><span class="n">{{ p.layers }} レイヤ</span>
			</div>
		</div>
		<div class="empty" data-if="no_poses">gameMemory に AnimPoseParams が無い (MITIRU_REFLECT に載せる。docs/TOOL_WINDOWS.md)</div>

		<div data-if="has_sel">
			<div class="label"><span class="dash">— </span>レイヤ · {{ sel_label }}<span data-if="in_place"> · in place</span></div>
			<div class="panel">
				<div class="layer" data-for="l : layers">
					<div class="top"><span class="clip">clip {{ l.clip }}</span><span class="time">{{ l.time }}</span><span class="flags">{{ l.mask }} · {{ l.flags }}</span></div>
					<div class="wrow"><div class="bar"><div class="fill" data-style-width="l.w"/></div><span class="wv">{{ l.weight }}</span></div>
				</div>
			</div>

			<div class="label"><span class="dash">— </span>このフレームのイベント</div>
			<div class="panel">
				<div class="ev" data-for="e : events"><span>event {{ e.name }}</span><span>clip {{ e.clip }}</span><span>{{ e.time }}</span></div>
				<div class="empty" data-if="no_events">なし</div>
			</div>

			<div class="label"><span class="dash">— </span>ルートモーション (このフレームの差分)</div>
			<div class="panel" data-if="has_root">
				<div class="kv2"><span class="k">移動</span><span class="v">{{ root_t }}</span></div>
				<div class="kv2"><span class="k">Y 回転</span><span class="v">{{ root_yaw }}</span></div>
			</div>
			<div class="empty" data-if="!has_root">同じ持ち主の YawXform が無い</div>
		</div>
	</div>
	<div class="wait">waiting for the game…</div>
</body>
</rml>
