<rml>
<head>
	<title>Stage editor</title>
	<link type="text/rcss" href="mitiru:tool_look.rcss"/>
	<style>
		.main { display: flex; margin-top: 8dp; }
		.views { flex: 1 1 auto; min-width: 360dp; }
		.side { flex: 0 0 300dp; margin-left: 16dp; }
		.view { margin-bottom: 8dp; }
		.pal { display: flex; flex-wrap: wrap; }
		.pal button { margin: 0dp 4dp 4dp 0dp; }
		.pal .sw { display: inline-block; width: 10dp; height: 10dp; margin-right: 8dp; border-radius: 2dp; }
		.pal .n { margin-left: 8dp; color: var(--text-2); font-size: 12dp; }
		.sel .t { font-weight: 600; }
		.sel .acts { margin-top: 8dp; }
		.sel .acts button { margin-right: 4dp; }
		.frow { display: flex; align-items: center; flex-wrap: wrap; min-height: 32dp; padding: 2dp 0dp; }
		.frow + .frow { border-top: 1dp var(--divider); }
		.frow .fl { flex: 0 0 64dp; color: var(--text-2); font-size: 12dp; }
		.frow .cn { margin: 0dp 2dp 0dp 4dp; color: var(--text-3); font-size: 12dp; }
		.frow input.text { width: 52dp; }
		.frow input.text.wide { width: 130dp; }
		.frow button { margin-left: 4dp; }
		.scroll { max-height: 190dp; overflow-y: auto; }
		.scroll.files { max-height: 96dp; }
		.list .item { min-height: 32dp; }
		.item .sm { margin-left: 8dp; color: var(--text-3); font-size: 12dp; }
		.bar .tabs { margin-bottom: 4dp; }
		.badges { margin-top: 4dp; }
	</style>
</head>
<body data-model="tool">
	<div class="page">
		<div class="infobar error" data-if="error != ''"><span class="ic">&#xE783;</span><span class="msg">{{ error }}</span></div>
		<div data-if="loaded">
			<div class="bar">
				<button data-event-click="dispatch('se.try')"><span class="ic">&#xE768;</span>Try</button>
				<button class="accent" data-event-click="dispatch('se.keep')"><span class="ic">&#xE74E;</span>Keep</button>
				<button data-event-click="dispatch('se.discard')"><span class="ic">&#xE74D;</span>Discard</button>
				<div class="sep"/>
				<button class="tipped icon" data-class-off="!can_undo" data-event-click="dispatch('se.undo')"><span class="ic only">&#xE7A7;</span><span class="tip short">Undo</span></button>
				<button class="tipped icon" data-class-off="!can_redo" data-event-click="dispatch('se.redo')"><span class="ic only">&#xE7A6;</span><span class="tip short">Redo</span></button>
				<div class="sep"/>
				<div class="tabs">
					<div class="tab" data-class-cur="mode == 'top'" data-event-click="dispatch('se.view', 'm', 'top')"><span>Top</span></div>
					<div class="tab" data-class-cur="mode == 'orbit'" data-event-click="dispatch('se.view', 'm', 'orbit')"><span>3D</span></div>
					<div class="tab" data-class-cur="mode == 'both'" data-event-click="dispatch('se.view', 'm', 'both')"><span>Both</span></div>
				</div>
				<button class="tipped icon" data-event-click="dispatch('se.fit')"><span class="ic only">&#xE9A6;</span><span class="tip short">Fit</span></button>
				<button class="tipped" data-class-on="auto_try" data-event-click="dispatch('se.auto')"><span class="ic">&#xE895;</span>Auto try<span class="tip short">Try after every edit</span></button>
				<span class="tip-host"><span class="ic mute">&#xE946;</span><span class="tip right">Top view: drag a shape to move it, drag white handles to resize or rotate, drag empty space to pan, wheel to zoom. 3D view: drag to orbit, wheel to zoom, click to select. Keys: arrows nudge, PageUp/PageDown height, Q/E rotate, Ctrl+D duplicate, Delete remove, Ctrl+Z/Ctrl+Y undo/redo, F fit.</span></span>
			</div>
			<div class="badges">
				<span class="badge warn" data-if="dirty">Unsaved changes</span>
				<span class="badge ok" data-if="tried">Tried in game</span>
				<span class="caption">{{ status }}</span>
			</div>
			<div class="caption mt-4 nowrap">{{ source_text }}</div>
			<div class="infobar warn" data-if="gen_by != ''">
				<span class="ic">&#xE7BA;</span><span class="msg">Generated by {{ gen_by }}. Edits are lost when the script runs.</span>
				<button data-event-click="dispatch('se.adopt')">Make manual</button>
			</div>
			<div class="main">
				<div class="views">
					<div class="caption">{{ orient }} - Grid {{ grid }} - {{ snap_text }}</div>
					<div class="surface view mt-4" data-if="mode != 'orbit'"><liveimage id="top"/></div>
					<div class="surface view" data-if="mode != 'top'"><liveimage id="orbit"/></div>
				</div>
				<div class="side">
					<div class="group-title"><span>Stages</span></div>
					<div class="card list scroll files">
						<div class="item" data-for="f : files" data-class-sel="f.cur" data-event-click="dispatch('se.open', 'name', f.name)"><span class="name">{{ f.name }}</span><span class="sm" data-if="f.gen">Generated</span></div>
					</div>
					<div class="group">
						<div class="group-title"><span>Add</span></div>
						<div class="pal">
							<button data-for="k : kinds" data-event-click="dispatch('se.add', 'k', k.i)"><span class="sw" data-style-background-color="k.color"/>{{ k.label }}<span class="n">{{ k.count }}</span></button>
						</div>
						<div class="caption" data-if="unmanaged != ''">{{ unmanaged }}</div>
					</div>
					<div class="group">
						<div class="group-title"><span>Selection</span></div>
						<div class="card empty" data-if="!has_sel"><span class="ic">&#xE946;</span><span>Nothing selected</span></div>
						<div class="card pad sel" data-if="has_sel">
							<div class="t">{{ sel_label }}</div>
							<div class="caption">{{ sel_summary }}</div>
							<div class="acts"><button class="small" data-event-click="dispatch('se.dup')"><span class="ic">&#xE8C8;</span>Duplicate</button><button class="small" data-event-click="dispatch('se.del')"><span class="ic">&#xE74D;</span>Delete</button></div>
							<div class="frow" data-for="r : rows">
								<span class="fl">{{ r.label }}</span>
								<span data-if="r.present">
									<span data-for="c : r.comps"><span class="cn">{{ c.n }}</span><input type="text" class="text small" data-attr-value="c.v" data-event-change="dispatch('se.field', 'key', r.key, 'i', c.i, 'v', ev.value)"/></span>
									<input type="text" class="text small wide" data-if="r.is_text" data-attr-value="r.text" data-event-change="dispatch('se.field', 'key', r.key, 'i', '-1', 'v', ev.value)"/>
									<button class="small" data-if="r.is_bool" data-event-click="dispatch('se.toggle', 'key', r.key)">{{ r.flag_text }}</button>
									<button class="small" data-if="r.optional" data-event-click="dispatch('se.rmfield', 'key', r.key)">Remove</button>
								</span>
								<button class="small" data-if="!r.present" data-event-click="dispatch('se.addfield', 'key', r.key)">Add</button>
							</div>
						</div>
					</div>
					<div class="group">
						<div class="group-title"><span>{{ list_title }}</span></div>
						<div class="card list scroll">
							<div class="item" data-for="it : items" data-class-sel="it.sel" data-event-click="dispatch('se.select', 'i', it.i)"><span class="name">{{ it.label }}</span><span class="sm">{{ it.summary }}</span></div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</body>
</rml>
