<rml>
<head>
	<title>Rewind</title>
	<link type="text/rcss" href="mitiru:tool_look.rcss"/>
	<style>
		/* ゲーム窓の下に付くシークバー: 再生 / 一時停止のボタン + アクセントの塗り + 丸いつまみ。キーを持つのは掴んだ後だけ */
		body { overflow: hidden; background-color: var(--bg-2); }
		.wrap { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; display: flex; align-items: center; padding: 0dp 16dp; }
		.pp { flex: 0 0 auto; width: 32dp; height: 32dp; margin-right: 16dp; border-radius: 16dp; background-color: var(--accent); color: var(--on-accent); cursor: pointer; text-align: center; line-height: 32dp; }
		.pp:hover { background-color: var(--accent-hover); }
		.pp:active { background-color: var(--accent-press); }
		.bar { position: relative; flex: 1 1 auto; height: 100%; cursor: pointer; }
		.track { position: absolute; left: 0dp; right: 0dp; top: 50%; height: 4dp; margin-top: -2dp; background-color: var(--track); border-radius: 2dp; }
		.fill { position: absolute; left: 0dp; top: 50%; height: 4dp; margin-top: -2dp; background-color: var(--accent); border-radius: 2dp; pointer-events: none; }
		.knob { position: absolute; top: 50%; width: 12dp; height: 12dp; margin-left: -6dp; margin-top: -6dp; border-radius: 6dp; background-color: var(--accent); box-shadow: var(--flyout) 0dp 0dp 0dp 3dp, #00000040 0dp 1dp 3dp 3dp; pointer-events: none; }
		/* 節目 (値が変わった / 閾値を跨いだフレーム)。名前の付いた系列 (RUN→JUMP) は重ねると上に名前が出る */
		.marks { position: absolute; left: 0dp; right: 0dp; top: 0dp; bottom: 0dp; pointer-events: none; }
		.mark { position: absolute; top: 50%; width: 2dp; height: 12dp; margin-left: -1dp; margin-top: -6dp; background-color: var(--text-3); pointer-events: auto; }
		.mark.k1, .mark.k2 { background-color: var(--caution); }
		.mark.labeled { background-color: var(--accent); height: 16dp; margin-top: -8dp; }
		/* カットシーンの区間 (hud.timelineMarker)。トラックの上に名前つきの帯で出す */
		.spans { position: absolute; left: 0dp; right: 0dp; top: 0dp; height: 50%; pointer-events: none; }
		.span { position: absolute; top: 6dp; height: 16dp; border-radius: 4dp; background-color: var(--accent-tint); border-left: 2dp var(--accent); font-size: 12dp; line-height: 16dp; color: var(--text-2); padding-left: 4dp; overflow: hidden; white-space: nowrap; }
		.wait { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; background-color: var(--bg-2); display: none; }
		body.is-waiting .wait { display: block; }
		/* 予算の見積もりと節目の名前。シークバーの邪魔にならない 1 行 */
		.budget { position: absolute; top: 0dp; right: 12dp; font-size: 12dp; line-height: 16dp; color: var(--text-3); pointer-events: none; }
		.hover { position: absolute; top: 0dp; left: 64dp; font-size: 12dp; line-height: 16dp; color: var(--accent); pointer-events: none; }
	</style>
</head>
<body data-model="tool" data-class-is-waiting="!ok" data-class-paused="paused" data-class-playing="!paused">
	<div class="wrap">
		<div class="pp" data-event-click="dispatch('tt.playpause')"><span class="ic" data-if="paused">&#xE768;</span><span class="ic" data-if="!paused">&#xE769;</span></div>
		<div class="bar" id="bar">
			<div class="spans"><div class="span" data-for="sp : spans" data-style-left="sp.left + '%'"
			     data-style-width="sp.width + '%'">{{ sp.label }}</div></div>
			<div class="track"/>
			<div class="fill" data-style-width="pct + '%'"/>
			<div class="knob" data-style-left="pct + '%'"/>
			<div class="marks">
				<div class="mark" data-for="m : marks" data-style-left="m.left + '%'" data-class-k1="m.k == 1" data-class-k2="m.k == 2"
				     data-class-labeled="m.labeled" data-event-mouseover="dispatch('tt.hover', 'i', m.i)" data-event-mouseout="dispatch('tt.hover', 'i', -1)"><span/></div>
			</div>
		</div>
	</div>
	<div class="budget">{{ budget }}</div>
	<div class="hover">{{ hover }}</div>
	<div class="wait"/>
</body>
</rml>
