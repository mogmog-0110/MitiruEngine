<rml>
<head>
	<title>Why</title>
	<link type="text/rcss" href="mitiru:tool_look.rcss"/>
	<style>
		.query { display: flex; align-items: center; }
		.query input.text { flex: 1 1 auto; margin-right: 8dp; }
		.blame.unsupported { color: var(--text-3); }
		.hist .row { align-items: baseline; min-height: 32dp; }
		.hist .v.newest { font-weight: 600; }
		.hist .v.muted { color: var(--text-2); }
	</style>
</head>
<body data-model="tool">
	<div class="page">
		<div class="infobar warn" data-if="banner != ''"><span class="ic">&#xE7BA;</span><span class="msg">{{ banner }}</span></div>
		<div class="query mt-8">
			<input type="text" class="text" id="field" placeholder="player.hp"
			       data-event-change="dispatch('why.field', 'v', ev.value, 'enter', ev.linebreak)"/>
			<button class="accent" data-event-click="dispatch('why.query')"><span class="ic">&#xE721;</span>Query</button>
		</div>
		<div class="infobar error" data-if="error != ''"><span class="ic">&#xE783;</span><span class="msg">{{ error }}</span></div>

		<div class="group">
			<div class="group-title"><span>Last written in</span></div>
			<div class="card pad"><div class="blame" data-class-unsupported="unsupported">{{ blame }}</div></div>
		</div>
		<div class="group">
			<div class="group-title"><span>Written by</span></div>
			<div class="card pad"><div class="blame">{{ ever_wrote }}</div></div>
		</div>
		<div class="group">
			<div class="group-title"><span>History</span></div>
			<div class="card hist">
				<div class="row" data-for="h : history">
					<div class="k">{{ h.k }}</div>
					<div class="v" data-class-newest="h.newest" data-class-muted="h.muted">{{ h.v }}</div>
				</div>
			</div>
		</div>
	</div>
</body>
</rml>
