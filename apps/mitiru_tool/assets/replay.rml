<rml>
<head>
	<title>Replay</title>
	<link type="text/rcss" href="mitiru:tool_look.rcss"/>
	<style>
		.scrub { position: relative; height: 24dp; margin-top: 12dp; cursor: pointer; }
		.scrub .rail { position: absolute; left: 0dp; right: 0dp; top: 10dp; height: 4dp; border-radius: 2dp; background-color: var(--track); }
		.scrub .cur { position: absolute; top: 6dp; width: 12dp; height: 12dp; margin-left: -6dp; border-radius: 6dp; background-color: var(--accent); box-shadow: var(--flyout) 0dp 0dp 0dp 3dp, #00000040 0dp 1dp 3dp 3dp; }
		.strip { display: flex; align-items: flex-end; height: 40dp; margin-top: 8dp; padding: 2dp; border-radius: 4dp; background-color: var(--subtle-press); overflow: hidden; }
		.strip .tick { display: block; flex: 1 1 0dp; min-width: 0dp; background-color: var(--accent); opacity: 0.7; }
		.keys { display: flex; flex-wrap: wrap; min-height: 28dp; }
	</style>
</head>
<body data-model="tool" data-class-is-waiting="!loaded">
	<div class="page">
		<div class="caption nowrap">{{ file }}</div>
		<div class="infobar error" data-if="error != ''"><span class="ic">&#xE783;</span><span class="msg">{{ error }}</span></div>
		<div data-if="ok">
			<div class="card pad mt-8">
				<div class="figure"><span>{{ cur }}</span><span class="unit">/ {{ total }}</span></div>
				<div class="scrub" id="scrub"><div class="rail"/><div class="cur" data-style-left="pct + '%'"/></div>
				<div class="strip"><div class="tick" data-for="s : strip" data-style-height="s.h + '%'"><span/></div></div>
			</div>
			<div class="group">
				<div class="group-title"><span>Held keys</span></div>
				<div class="keys">
					<span class="badge" data-if="keys.size == 0">None</span>
					<span class="badge accent" data-for="k : keys">{{ k }}</span>
				</div>
			</div>
			<div class="group">
				<div class="card">
					<div class="row compact"><span class="k">Frame</span><span class="v">{{ frame.i }}</span></div>
					<div class="row compact"><span class="k">Mouse</span><span class="v">{{ frame.mouse }}<span data-if="frame.mb != ''"> - {{ frame.mb }}</span></span></div>
					<div class="row compact"><span class="k">Gamepad</span><span class="v"><span data-if="frame.pad">Connected</span><span class="faint" data-if="!frame.pad">None</span></span></div>
				</div>
			</div>
			<div class="group" data-if="frame.pad">
				<div class="keys">
					<span class="badge" data-if="pad_buttons.size == 0">No buttons</span>
					<span class="badge accent" data-for="b : pad_buttons">{{ b }}</span>
				</div>
				<div class="card mt-8">
					<div class="row compact"><span class="k">Left stick</span><span class="v">{{ stick_l }}</span></div>
					<div class="row compact"><span class="k">Right stick</span><span class="v">{{ stick_r }}</span></div>
					<div class="row compact"><span class="k">Triggers</span><span class="v">{{ trigger }}</span></div>
				</div>
			</div>
		</div>
	</div>
	<div class="wait"><span class="ic">&#xE81C;</span>Waiting for a recording</div>
</body>
</rml>
