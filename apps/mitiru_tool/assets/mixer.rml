<rml>
<head>
	<title>Audio mixer</title>
	<link type="text/rcss" href="mitiru:tool_look.rcss"/>
	<style>
		.cols { display: flex; align-items: flex-start; }
		.col + .col { margin-left: 40dp; }
		.vbar { position: relative; width: 24dp; height: 160dp; margin-top: 8dp; border-radius: 4dp; background-color: var(--subtle-hover); border: 1dp var(--card-stroke); overflow: hidden; }
		.vbar .fill { position: absolute; left: 0dp; right: 0dp; bottom: 0dp; background-color: var(--accent); }
		.master { display: flex; align-items: flex-end; }
		.master .figure { margin-left: 16dp; font-size: 28dp; line-height: 36dp; }
		.vu { display: flex; }
		.ch { display: flex; flex-direction: column; align-items: center; margin-right: 12dp; }
		.ch .vbar { margin-top: 8dp; }
		.ch .vbar .fill { background-color: var(--text-2); }
		.ch .vbar .fill.music { background-color: var(--accent); }
		.ch .tag { margin-top: 6dp; font-size: 12dp; line-height: 16dp; color: var(--text-2); }
		.voice { display: flex; align-items: baseline; flex-wrap: wrap; padding: 6dp 16dp; }
		.voice span { margin-right: 12dp; }
		.voice .id { font-weight: 600; }
		.voice .gain { min-width: 40dp; text-align: right; }
	</style>
</head>
<body data-model="tool" data-class-is-waiting="!ready">
	<div class="page">
		<div class="card pad">
			<div class="cols">
				<div class="col">
					<div class="caption">Master</div>
					<div class="master">
						<div class="vbar"><div class="fill" data-style-height="master_h"/></div>
						<div class="figure"><span>{{ master_pct }}</span><span class="unit">%</span></div>
					</div>
					<div class="caption mt-8" data-if="engine != ''">{{ engine }}</div>
				</div>
				<div class="col">
					<div class="caption">Channels</div>
					<div class="vu">
						<div class="ch" data-for="c : channels">
							<div class="vbar"><div class="fill" data-class-music="c.music" data-style-height="c.h"/></div>
							<div class="tag">{{ c.tag }}</div>
						</div>
					</div>
					<div class="caption mt-8" data-if="silent"><span class="ic">&#xE74F;</span> Silent</div>
				</div>
			</div>
		</div>
		<!-- hud.voice() で鳴らした台詞の枠。id は game が付けた名前、asset は実ファイル名、残り秒は backend が
		     length - cursor で出す (ループ / 不明なら欄ごと出ない)。 -->
		<div class="group">
			<div class="group-title"><span>Voices</span></div>
			<div class="card">
				<div class="voice" data-for="v : voices">
					<span class="id" data-if="v.has_id">{{ v.id }}</span>
					<span class="faint" data-if="!v.has_id">-</span>
					<span class="muted" data-if="v.has_asset">{{ v.asset }}</span>
					<span class="gain">{{ v.gain }}</span>
					<span>{{ v.pan }}</span>
					<span class="muted" data-if="v.has_left">{{ v.left }}</span>
				</div>
				<div class="empty" data-if="no_voice"><span>No voices</span></div>
			</div>
		</div>
	</div>
	<div class="wait"><span class="ic">&#xE895;</span>Waiting for the game</div>
</body>
</rml>
