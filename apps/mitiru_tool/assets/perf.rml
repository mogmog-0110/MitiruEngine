<rml>
<head>
	<title>Performance</title>
	<link type="text/rcss" href="mitiru:tool_look.rcss"/>
	<style>
		.hero { display: flex; align-items: flex-end; }
		.hero .main { flex: 1 1 auto; }
		.hero .side { flex: 0 0 auto; text-align: right; }
		spark { display: block; position: relative; width: 100%; height: 120dp; margin-top: 12dp; color: var(--accent); border-top-width: 0dp; border-top-color: var(--divider); }
		.spark-label { position: absolute; right: 4dp; font-size: 12dp; line-height: 16dp; color: var(--text-3); }
		.pass { display: flex; align-items: center; min-height: 32dp; padding: 0dp 16dp; }
		.pass .name { flex: 0 0 96dp; }
		.pass.part .name { padding-left: 16dp; color: var(--text-2); }
		.pass .meter { flex: 1 1 auto; margin: 0dp 12dp; }
		.pass .ms { flex: 0 0 56dp; text-align: right; }
		.pass .val { flex: 0 0 140dp; text-align: right; }
	</style>
</head>
<body data-model="tool" data-class-is-waiting="!ready">
	<div class="page">
		<div class="card pad">
			<div class="hero">
				<div class="main">
					<div class="caption">Frame rate</div>
					<div class="figure"><span>{{ fps }}</span><span class="unit">fps</span></div>
				</div>
				<div class="side">
					<div class="caption">Frame time</div>
					<div class="subtitle"><span>{{ frame_ms }}</span><span class="caption"> ms</span></div>
				</div>
			</div>
			<div class="tip-host"><span class="ic mute">&#xE946;</span>
				<div class="tip">Frame rate counts the whole frame: update, draw, present and UI. Frame time is the wall-clock time of one tick, without GPU execution or OS scheduler waits.</div>
			</div>
			<div class="infobar warn" data-if="slow"><span class="ic">&#xE7BA;</span><span class="msg">Slow motion: <span>{{ dropped }}</span> steps dropped</span></div>
			<spark seq="0" themed="" data-attr-value="fps_value" data-attr-seq="sample" cap="180" baseline="60" min="75"><span class="spark-label">60</span></spark>
		</div>

		<div class="group" data-if="has_gpu">
			<div class="group-title"><span class="grow">GPU</span><span class="caption"><span>{{ gpu_total }}</span> ms</span></div>
			<div class="card">
				<div class="pass" data-for="g : gpu_rows" data-class-part="g.part">
					<span class="name">{{ g.name }}</span><div class="meter"><div class="fill" data-style-width="g.w"/></div><span class="ms">{{ g.ms }}</span>
				</div>
			</div>
		</div>
		<div class="group" data-if="has_loads">
			<div class="group-title"><span class="grow">Loads</span><span class="caption"><span>{{ loads_pending }}</span> pending</span></div>
			<div class="card">
				<div class="pass"><span class="name">Assets</span><div class="meter"><div class="fill" data-style-width="loads_w"/></div><span class="val">{{ loads_mb }}</span></div>
				<div class="pass"><span class="name">VRAM</span><div class="meter"><div class="fill" data-style-width="vram_w"/></div><span class="val">{{ vram_mb }}</span></div>
				<div class="pass" data-if="has_cells"><span class="name">Cells</span><span class="grow"/><span class="val">{{ cells }}</span></div>
			</div>
			<div class="caption mt-8">Slowest load: <span>{{ loads_max_ms }}</span> ms</div>
		</div>
	</div>
	<div class="wait"><span class="ic">&#xE895;</span>Waiting for the game</div>
</body>
</rml>
