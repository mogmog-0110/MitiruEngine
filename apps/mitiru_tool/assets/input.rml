<rml>
<head>
	<title>input</title>
	<link type="text/rcss" href="tool.rcss"/>
</head>
<!-- input 専用の窓: snapshot の "input" 節だけを出す (C++ 側で絞る) -->
<body data-model="tool" data-class-is-waiting="!ready">
	<header><div class="dot"/><h1>input</h1></header>
	<div class="body">
		<div data-for="sec : sections">
			<div class="section-title">{{ sec.title }}</div>
			<div class="kv">
				<div data-for="it : sec.items">
					<div class="row" data-if="!it.group">
						<span class="k" data-if="it.has_k">{{ it.k }}</span>
						<span class="v">
							<span data-if="it.w == 'text'">{{ it.v }}</span>
							<span class="enum-box" data-if="it.w == 'enum'">{{ it.v }}<span class="arrow">▼</span></span>
							<span data-if="it.w == 'range'"><input type="range" class="range" disabled="" data-attr-min="it.min" data-attr-max="it.max" data-attr-value="it.val"/>{{ it.v }}</span>
						</span>
					</div>
					<div class="group" data-if="it.group">
						<div class="summary" data-event-click="dispatch('kv.group', 'name', it.name)">{{ it.open ? '- ' : '+ ' }}{{ it.name }}</div>
						<div data-if="it.open">
							<div class="row" data-for="r : it.rows">
								<span class="k" data-if="r.has_k">{{ r.k }}</span>
								<span class="v">
									<span data-if="r.w == 'text'">{{ r.v }}</span>
									<span class="enum-box" data-if="r.w == 'enum'">{{ r.v }}<span class="arrow">▼</span></span>
									<span data-if="r.w == 'range'"><input type="range" class="range" disabled="" data-attr-min="r.min" data-attr-max="r.max" data-attr-value="r.val"/>{{ r.v }}</span>
								</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="wait">waiting for the game…</div>
</body>
</rml>
