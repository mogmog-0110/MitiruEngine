<rml>
<head>
	<title>AI</title>
	<link type="text/rcss" href="mitiru:tool_look.rcss"/>
	<style>
		.agent .root { flex: 0 0 auto; margin-left: 12dp; }
		.node { display: flex; align-items: center; min-height: 28dp; padding: 0dp 12dp; }
		.node .idx { flex: 0 0 24dp; margin-right: 8dp; text-align: right; color: var(--text-3); font-size: 12dp; }
		.node .box { flex: 0 0 auto; width: 12dp; height: 12dp; margin-right: 8dp; border-radius: 6dp; background-color: var(--track); }
		.node .box.running { background-color: var(--accent); }
		.node .box.success { background-color: var(--success); }
		.node .box.failure { background-color: var(--critical); }
		.node .kind { margin-right: 8dp; color: var(--text-2); font-size: 12dp; }
		.node.running .nm { font-weight: 600; }
		.legend .sw { border-width: 0dp; border-radius: 5dp; background-color: var(--track); }
		.legend .sw.running { background-color: var(--accent); }
		.legend .sw.success { background-color: var(--success); }
		.legend .sw.failure { background-color: var(--critical); }
		.holder { display: inline-block; margin: 4dp 4dp 0dp 0dp; }
	</style>
</head>
<body data-model="tool" data-class-is-waiting="!ready">
	<div class="page">
		<div class="group">
			<div class="group-title"><span>Agents</span></div>
			<div class="card list" data-if="!no_agents">
				<div class="item agent" data-for="a : agents" data-class-sel="a.selected" data-event-click="dispatch('ai.select', 'label', a.label)">
					<span class="name">{{ a.label }}</span><span class="meta root">{{ a.root }}</span><span class="meta">{{ a.running }}</span>
				</div>
			</div>
			<div class="card empty" data-if="no_agents"><span class="ic">&#xE946;</span><span>No agents</span></div>
		</div>

		<div data-if="has_sel">
			<div class="group">
				<div class="group-title"><span class="grow">Behavior tree</span><span class="caption">{{ sel_label }}</span></div>
				<div class="infobar warn" data-if="tree_file == ''"><span class="ic">&#xE946;</span><span class="msg">No tree file</span></div>
				<div class="err" data-if="tree_error != ''">{{ tree_error }}</div>
				<div class="card mt-8">
					<div class="node" data-for="n : nodes" data-class-running="n.running">
						<span class="idx">{{ n.index }}</span>
						<span class="box" data-class-running="n.st == 'running'" data-class-success="n.st == 'success'" data-class-failure="n.st == 'failure'"/>
						<span data-style-padding-left="n.pad"><span class="kind">{{ n.kind }}</span><span class="nm">{{ n.name }}</span></span>
					</div>
				</div>
				<div class="legend"><span class="it"><span class="sw running"/><span>Running</span></span><span class="it"><span class="sw success"/><span>Success</span></span><span class="it"><span class="sw failure"/><span>Failure</span></span><span class="it"><span class="sw"/><span>Idle</span></span></div>
			</div>

			<div class="group">
				<div class="group-title"><span>Perception</span></div>
				<div class="card" data-if="has_mind">
					<div class="row compact"><span class="k">Level</span><span class="v">{{ mind_level }}</span></div>
					<div class="row compact"><span class="k">Awareness</span><span class="v"><span>{{ mind_aware }}</span><div class="meter solid mt-4"><div class="fill" data-style-width="mind_aware_w"/></div></span></div>
					<div class="row compact"><span class="k">Visible</span><span class="v"><span class="ic accent" data-if="mind_seen">&#xE890;</span><span class="faint" data-if="!mind_seen">No</span></span></div>
					<div class="row compact"><span class="k">Last seen at</span><span class="v">{{ mind_last }}</span></div>
				</div>
				<div class="card empty" data-if="!has_mind"><span>No perception data</span></div>
			</div>
		</div>

		<div class="group">
			<div class="group-title"><span>Attack tokens</span></div>
			<div class="card pad" data-for="p : pools">
				<div class="row-flex"><span class="grow">{{ p.label }}</span><span class="caption">{{ p.used }} / {{ p.capacity }} used, {{ p.requests }} requested</span></div>
				<span class="badge accent holder" data-for="h : p.holders">id {{ h.id }} - cost {{ h.cost }} - since {{ h.since }}</span>
			</div>
			<div class="card empty" data-if="no_pool"><span>No token pool</span></div>
		</div>
	</div>
	<div class="wait"><span class="ic">&#xE895;</span>Waiting for the game</div>
</body>
</rml>
